# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA - ASISTENTE DE SALUD PÚBLICA (CASO 05 - UNIANDES)
# ==============================================================================
# Copia este archivo como .env y completa los valores con tus credenciales locales.
# REGLA DE ORO 5: El archivo .env NUNCA debe subirse a Git ni compartirse.

# --- ENTORNO Y EJECUCIÓN ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# --- PROVEEDOR GENERATIVO (LLM) - INTEGRACIÓN DEL KIT SEMANA 2 ---
# Proveedor principal y de respaldo (opciones: gemini | groq | simulado)
LLM_PRINCIPAL=gemini
LLM_RESPALDO=groq

# Clave y modelo de Google Gemini (Obtén tu clave gratuita en: https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_clave_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Clave y modelo de Groq (Obtén tu clave gratuita en: https://console.groq.com/keys)
GROQ_API_KEY=tu_clave_groq_aqui
GROQ_MODEL=openai/gpt-oss-20b

# Parámetros operativos y resiliencia de llamadas
LLM_TIMEOUT_S=15
LLM_MAX_TOKENS=2048
LLM_REINTENTOS=2
# Nivel de razonamiento antes de responder (low | medium | high)
LLM_RAZONAMIENTO=low

# --- PROVEEDOR EMBEDDINGS Y VECTOR STORE (RAG) ---
EMBEDDING_MODEL=models/text-embedding-004
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=dengue_msp_ops_knowledge

# --- UMBRALES DE RAG Y SALVAGUARDAS ---
# Umbral mínimo de similitud para considerar relevante un fragmento (0.0 a 1.0)
RELEVANCE_THRESHOLD=0.65
TOP_K_RESULTS=4

# --- RUTAS DE DATOS LOCALES ---
GEOSALUD_DATA_PATH=data/geosalud_ecuador.json
RAW_DATA_DIR=data/raw

# --- TELÉFONOS Y CANALES DE EMERGENCIA NACIONAL (ECUADOR) ---
EMERGENCY_PHONE=911
MSP_CITAS_PHONE=171
MSP_OFFICIAL_URL=https://www.salud.gob.ec
